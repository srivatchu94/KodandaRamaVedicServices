# Where booking-form enquiries are submitted (e.g. a Formspree endpoint).
# Create a free form at https://formspree.io using the recipient email you
# want enquiries delivered to, then paste its endpoint below.
# Example: https://formspree.io/f/xxxxabcd
VITE_FORM_ENDPOINT=

# Fallback recipient used only when VITE_FORM_ENDPOINT is not set (the site
# will open the visitor's email app with the enquiry pre-filled instead).
VITE_ENQUIRY_EMAIL=srivatchu94@gmail.com
